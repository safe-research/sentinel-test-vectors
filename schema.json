{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safenet Sentinel Test Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction",
    "block",
    "verdict"
  ],
  "properties": {
    "transaction": {
      "$ref": "#/$defs/safeTransaction"
    },
    "block": {
      "$ref": "#/$defs/quantity"
    },
    "verdict": {
      "enum": [
        "secure",
        "insecure"
      ]
    },
    "rule": {
      "type": "string",
      "pattern": "^R-[0-9]+\\.[0-9]+$"
    },
    "note": {
      "type": "string"
    },
    "txHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "insecure"
          }
        }
      },
      "then": {
        "properties": {
          "rule": true
        },
        "required": [
          "rule"
        ]
      },
      "else": {
        "not": {
          "properties": {
            "rule": true
          },
          "required": [
            "rule"
          ]
        }
      }
    }
  ],
  "$defs": {
    "safeTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "safe",
        "to",
        "value",
        "data",
        "operation",
        "safeTxGas",
        "baseGas",
        "gasPrice",
        "gasToken",
        "refundReceiver",
        "nonce"
      ],
      "properties": {
        "chainId": {
          "$ref": "#/$defs/quantity"
        },
        "safe": {
          "$ref": "#/$defs/address"
        },
        "to": {
          "$ref": "#/$defs/address"
        },
        "value": {
          "$ref": "#/$defs/quantity"
        },
        "data": {
          "$ref": "#/$defs/bytes"
        },
        "operation": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "safeTxGas": {
          "$ref": "#/$defs/quantity"
        },
        "baseGas": {
          "$ref": "#/$defs/quantity"
        },
        "gasPrice": {
          "$ref": "#/$defs/quantity"
        },
        "gasToken": {
          "$ref": "#/$defs/address"
        },
        "refundReceiver": {
          "$ref": "#/$defs/address"
        },
        "nonce": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^0x([1-9a-f][0-9a-f]*|0)$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^0x([0-9a-f]{2})*$"
    }
  }
}
