{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safenet Sentinel Test Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "response"
  ],
  "properties": {
    "request": {
      "$ref": "#/$defs/request"
    },
    "response": {
      "$ref": "#/$defs/response"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "response": {
            "properties": {
              "verdict": {
                "const": "insecure"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "properties": {
              "rule": true
            },
            "required": [
              "rule"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "response": {
            "not": {
              "properties": {
                "rule": true
              },
              "required": [
                "rule"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "transaction"
      ],
      "properties": {
        "block": {
          "$ref": "#/$defs/quantity"
        },
        "transaction": {
          "$ref": "#/$defs/safeTransaction"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "secure",
            "insecure"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^R-[0-9]+\\.[0-9]+$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        },
        "exampleTransaction": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "safeTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "safe",
        "to",
        "value",
        "data",
        "operation",
        "safeTxGas",
        "baseGas",
        "gasPrice",
        "gasToken",
        "refundReceiver",
        "nonce"
      ],
      "properties": {
        "chainId": {
          "$ref": "#/$defs/quantity"
        },
        "safe": {
          "$ref": "#/$defs/address"
        },
        "to": {
          "$ref": "#/$defs/address"
        },
        "value": {
          "$ref": "#/$defs/quantity"
        },
        "data": {
          "$ref": "#/$defs/bytes"
        },
        "operation": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "safeTxGas": {
          "$ref": "#/$defs/quantity"
        },
        "baseGas": {
          "$ref": "#/$defs/quantity"
        },
        "gasPrice": {
          "$ref": "#/$defs/quantity"
        },
        "gasToken": {
          "$ref": "#/$defs/address"
        },
        "refundReceiver": {
          "$ref": "#/$defs/address"
        },
        "nonce": {
          "$ref": "#/$defs/quantity"
        }
      }
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^0x([1-9a-f][0-9a-f]*|0)$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^0x([0-9a-f]{2})*$"
    }
  }
}
